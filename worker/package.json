{
  "name": "club-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply club-prod --remote",
    "db:migrate:staging": "wrangler d1 migrations apply club-staging --env staging --remote",
    "migrate-data": "tsx scripts/migrate-data.ts",
    "migrate-data:staging": "tsx scripts/migrate-data.ts --env staging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
